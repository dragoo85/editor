{
  "expo": {
    "name": "GOLIATH",
    "slug": "goliath",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "goliath",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#07080a",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goliath.mobile"
    },
    "android": {
      "package": "com.goliath.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-document-picker"],
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}