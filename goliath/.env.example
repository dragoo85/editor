# ---------------------------------------------------------------------------
# GOLIATH environment configuration (copy to .env.local and fill in)
# NEVER commit .env.local
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used for token encryption lookups and administrative jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Token encryption: 32 random bytes, base64 encoded.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOLIATH_TOKEN_ENCRYPTION_KEY=

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# Enable the Google Drive API first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
# Requested scope. Default grants full management of Drive content.
# Narrower options: https://www.googleapis.com/auth/drive.file (app-created files only)
#                   https://www.googleapis.com/auth/drive.readonly (view only, uploads fail)
GOLIATH_DRIVE_SCOPE=https://www.googleapis.com/auth/drive

# AI (all optional). Without a key, GOLIATH AI runs in local/disabled mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Transfer tuning
GOLIATH_UPLOAD_CHUNK_BYTES=5242880
GOLIATH_MAX_CONCURRENT_UPLOADS=2
GOLIATH_MAX_CONCURRENT_DOWNLOADS=3