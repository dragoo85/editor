{
  "name": "lumina-photo-studio",
  "version": "1.0.0",
  "description": "Professional Offline-First Desktop Photo Editor and RAW Processor",
  "main": "dist-electron/main.js",
  "author": "Lumina Photo Studio Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "vite",
    "electron:build": "tsc && vite build && electron-builder"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "exifreader": "^4.23.6",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "type": "module",
  "build": {
    "appId": "com.lumina.photostudio",
    "productName": "Lumina Photo Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "sign": null,
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    }
  }
}